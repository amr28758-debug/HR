# ─── Burtplace Workforce — environment template ───────────────────────────────
# Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/burtplace_dev
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/burtplace_test
DATABASE_POOL_MAX=20

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# ─── Authentication ───────────────────────────────────────────────────────────
# AUTH_MODE=entra  → validate Microsoft Entra ID access tokens (JWKS). Production.
# AUTH_MODE=local  → local dev login (email + password from seed users). Dev only.
AUTH_MODE=local
# Local mode secret used to sign session JWTs (min 32 chars). Generate: openssl rand -hex 32
AUTH_LOCAL_JWT_SECRET=change-me-to-a-64-char-random-hex-string-before-running
AUTH_SESSION_TTL_SECONDS=28800

# Microsoft Entra ID (required when AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Audience expected in access tokens (usually api://<client-id> or the client id itself)
ENTRA_API_AUDIENCE=
# Optional: map Entra app roles / groups to Burtplace roles in the DB (see docs/RBAC.md)

# Service accounts (device gateway, integrations) authenticate with API keys.
# Keys are stored hashed in the DB; this is only the pepper used when hashing.
API_KEY_PEPPER=change-me-random-string

# ─── Object storage (S3-compatible: MinIO in dev) ─────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=burtplace-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Biometric integration ────────────────────────────────────────────────────
# Provider: "webhook" (devices/middleware push events to us), "vyom" (poll COSEC VYOM — REQUIRES VENDOR CONFIRMATION), "none"
BIOMETRIC_PROVIDER=webhook
# VYOM adapter settings (only used when BIOMETRIC_PROVIDER=vyom) — endpoints must come from official Matrix documentation
VYOM_BASE_URL=
VYOM_USERNAME=
VYOM_PASSWORD=
VYOM_POLL_INTERVAL_SECONDS=60

# ─── Company / locale ─────────────────────────────────────────────────────────
COMPANY_NAME="Burtplace General Contracting"
COMPANY_TIMEZONE=Asia/Dubai
DEFAULT_LOCALE=en

# ─── Web ──────────────────────────────────────────────────────────────────────
# Leave NEXT_PUBLIC_API_URL empty to call the API through the web origin (Next.js rewrite → API_INTERNAL_URL). Set it only for a separate API host.
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://localhost:4000
